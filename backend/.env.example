DATABASE_PATH=./jarvis.db
# Hosted PostgreSQL connection string for deployment (for example, Neon).
DATABASE_URL=
APP_SECRET=change-this-before-deployment
FRONTEND_ORIGIN=http://localhost:5173
PAPER_STARTING_CASH=1000000
MAX_ORDER_QUANTITY=1000
MAX_ORDER_NOTIONAL=500000
ALLOW_SHORT_SELLING=true
DEMO_STRATEGY_KEY=demo-strategy-key
# One-year, read-only Analytics Token for search, quotes, and scanners.
UPSTOX_MARKET_DATA_TOKEN=
# Daily OAuth token reserved for live account and order operations.
UPSTOX_ACCESS_TOKEN=
UPSTOX_API_BASE_URL=https://api.upstox.com
UPSTOX_SANDBOX_ACCESS_TOKEN=
UPSTOX_SANDBOX_BASE_URL=https://api-sandbox.upstox.com
UPSTOX_ORDER_BASE_URL=https://api-hft.upstox.com
LIVE_TRADING_ENABLED=false
ALLOW_LIVE_STRATEGIES=false
